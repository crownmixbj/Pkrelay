# PKRELAY environment
#
# Copy this file to `.env.local` (git-ignored) and fill in your own values,
# then restart the dev server — Expo only reads env vars at bundler startup.
#
#   cp .env.example .env.local
#
# Find both values in your Supabase dashboard under
# Project Settings -> API. Use the *anon / public* key. Never put the
# service_role key in this file: anything prefixed EXPO_PUBLIC_ is compiled
# into the app bundle and is readable by anyone who installs it.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Web only, and only for link previews: the origin this build is served from,
# e.g. https://staging.pkrelay.com. og:image and og:url have to be absolute or
# WhatsApp and Facebook show a blank card. Leave it unset locally — the tags
# fall back to rooted paths and the page is unaffected.
EXPO_PUBLIC_SITE_URL=
