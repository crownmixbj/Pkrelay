{
  "expo": {
    "name": "PKRELAY",
    "slug": "parcel_mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "parcelmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.loci.parcel",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Package Relay uses the camera to photograph a parcel at handover and to capture your driver documents.",
        "NSPhotoLibraryUsageDescription": "Package Relay lets you attach a photo of a parcel or a driver document from your library."
      },
      "associatedDomains": [
        "applinks:REPLACE_WITH_LINK_DOMAIN"
      ]
    },
    "android": {
      "package": "com.loci.parcel",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "REPLACE_WITH_LINK_DOMAIN",
              "pathPrefix": "/capture"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#0077B6"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Package Relay lets you attach a photo of a parcel or a driver document from your library.",
          "cameraPermission": "Package Relay uses the camera to photograph a parcel at handover and to capture your driver documents.",
          "microphonePermission": false
        }
      ],
      "expo-document-picker",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "75625d41-84a6-478e-959c-2d420981d4ad"
      }
    }
  }
}
