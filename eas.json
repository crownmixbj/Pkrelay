{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_BUILD_CHANNEL": "base"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BUILD_CHANNEL": "development"
      },
      "android": {
        "buildType": "apk"
      },
      "environment": "development"
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BUILD_CHANNEL": "preview"
      },
      "android": {
        "buildType": "apk"
      },
      "environment": "preview"
    },
    "preview-testflight": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BUILD_CHANNEL": "preview"
      },
      "environment": "preview"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "node": "22.23.2",
      "env": {
        "EXPO_PUBLIC_BUILD_CHANNEL": "production"
      },
      "android": {
        "buildType": "apk"
      },
      "environment": "production"
    }
  },
  "submit": {
    "preview-testflight": {
      "ios": {
        "appleId": "REPLACE_WITH_YOUR_APPLE_ID_EMAIL",
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "REPLACE_WITH_YOUR_APPLE_TEAM_ID"
      }
    },
    "production": {
      "ios": {
        "appleId": "REPLACE_WITH_YOUR_APPLE_ID_EMAIL",
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "REPLACE_WITH_YOUR_APPLE_TEAM_ID"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
